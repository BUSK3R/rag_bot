# 복사해서 쓰세요:  cp .env.example .env
# 모든 값은 선택 사항입니다. 지정하지 않으면 src/ragbot/config.py 의 기본값이 쓰입니다.

# --- LLM ---
# 호스트에서 Ollama 를 돌리는 경우(기본)
RAGBOT_OLLAMA_BASE_URL=http://localhost:11434
# docker compose --profile ollama 로 컨테이너까지 띄우는 경우
# RAGBOT_OLLAMA_BASE_URL=http://ollama:11434
RAGBOT_LLM_MODEL=hf.co/DevQuasar/kakaocorp.kanana-1.5-8b-instruct-2505-GGUF:Q4_K_M

# --- 검색 ---
RAGBOT_TOP_K=4
# 최고 점수가 이보다 낮으면 LLM 을 부르지 않고 "찾지 못했습니다"로 답합니다.
RAGBOT_MIN_SCORE=0.30
# 프롬프트에 실을 근거의 총 글자수. 응답 지연의 대부분은 생성이 아니라 긴 프롬프트를
# 읽는 prefill 이라, 이 값이 체감 속도에 가장 직접적입니다.
RAGBOT_MAX_CONTEXT_CHARS=2400
# 하이브리드 검색에서 밀집(의미) 비중. 나머지가 BM25(정확 토큰) 몫입니다.
# 숫자·날짜·법조문이 많은 공문은 BM25 쪽(=낮은 값)이 유리할 수 있습니다.
RAGBOT_DENSE_WEIGHT=0.5

# --- 청킹 (값을 바꾸면 다시 ingest 해야 합니다) ---
RAGBOT_CHUNK_SIZE=1200
RAGBOT_CHUNK_OVERLAP=200

# --- 임베딩 ---
RAGBOT_EMBED_MODEL=nlpai-lab/KURE-v1
# GPU 를 임베딩에 쓰고 싶으면 cuda. 기본은 cpu(6GB VRAM 을 LLM 에 양보).
RAGBOT_EMBED_DEVICE=cpu
